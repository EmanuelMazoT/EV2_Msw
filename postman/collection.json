{
  "info": {
    "_postman_id": "ev2msw-0000-0000-0000-0000proveedor",
    "name": "Ev2_Msw - Proveedores CRUD",
    "description": "Plantilla de coleccion para el CRUD de Proveedor (Ev2_Msw / evaluaciont2). Usa la variable {{baseUrl}}. Establece baseUrl con la URL publica del Web Service desplegado en Render.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://REEMPLAZAR-POR-URL-RENDER.onrender.com"
    }
  ],
  "item": [
    {
      "name": "GET Listar proveedores",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/proveedores",
          "host": ["{{baseUrl}}"],
          "path": ["api", "proveedores"]
        },
        "description": "Lista todos los proveedores."
      },
      "response": []
    },
    {
      "name": "GET Proveedor por id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/proveedores/1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "proveedores", "1"]
        },
        "description": "Obtiene un proveedor por su id."
      },
      "response": []
    },
    {
      "name": "POST Crear proveedor",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Proveedor Evaluacion\",\n  \"dni\": \"79999999\",\n  \"tipoProveedor\": {\n    \"idDataCatalogo\": 1\n  },\n  \"pais\": {\n    \"idPais\": 1\n  },\n  \"estado\": 1\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/proveedores",
          "host": ["{{baseUrl}}"],
          "path": ["api", "proveedores"]
        },
        "description": "Crea un proveedor. Requiere tipoProveedor.idDataCatalogo y pais.idPais validos. Si el DNI ya existe devuelve 409 CONFLICT."
      },
      "response": []
    },
    {
      "name": "PUT Actualizar proveedor",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Proveedor Actualizado\",\n  \"dni\": \"79999999\",\n  \"tipoProveedor\": {\n    \"idDataCatalogo\": 1\n  },\n  \"pais\": {\n    \"idPais\": 1\n  },\n  \"estado\": 1\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/proveedores/1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "proveedores", "1"]
        },
        "description": "Actualiza el proveedor con el id indicado."
      },
      "response": []
    },
    {
      "name": "DELETE Eliminar proveedor",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/proveedores/1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "proveedores", "1"]
        },
        "description": "Elimina el proveedor con el id indicado. Devuelve 204 si fue eliminado."
      },
      "response": []
    }
  ]
}